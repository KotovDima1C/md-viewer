<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>md-viewer</AssemblyName>
    <RootNamespace>MdViewer</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Быстрый холодный старт: код заранее скомпилирован в машинный -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <Product>MD Viewer</Product>
    <Version>0.6.1</Version>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WebView2 тянет WPF-сборку, которая нам не нужна: конфликт версий WindowsBase безвреден -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Лицензии кладутся рядом с exe: и в установленную программу, и в архив релиза -->
    <None Include="..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.38.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="style.css" LogicalName="style.css" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <EmbeddedResource Include="page.js" LogicalName="page.js" />
    <EmbeddedResource Include="vendor\highlight.js" LogicalName="highlight.js" />
    <EmbeddedResource Include="vendor\highlight.css" LogicalName="highlight.css" />
    <EmbeddedResource Include="vendor\mermaid.js" LogicalName="mermaid.js" />
  </ItemGroup>

</Project>
